# --- Store ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="919718282121"

# --- Email (Resend) ---------------------------------------------------------
# ATELIER_EMAIL is the only address you need to set: it is where client
# enquiries land. Paste a Resend API key beside it and briefs, appointment
# requests and design-fee receipts start arriving there.
#
# MAIL_FROM is optional. Left blank we send from Resend's shared sender, which
# Resend will only deliver to the address that owns the Resend account -- so
# make sure the key below belongs to an account registered on ATELIER_EMAIL.
# Set MAIL_FROM to a domain verified in Resend (e.g.
# "Sanskar & Kabir <studio@sanskarandkabir.com>") to lift that, which also
# re-enables the acknowledgement email sent back to the customer.
RESEND_API_KEY=
MAIL_FROM=
ATELIER_EMAIL=
