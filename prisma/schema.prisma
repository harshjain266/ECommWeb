generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]
  wishlist  WishlistItem[]
  cart      Cart?
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String  @default("India")
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

/// Two-level navigation: a parent Category (e.g. "Women") owns
/// sub-categories (e.g. "Lehengas"). `parentId == null` => top-level nav item.
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  parentId    String?
  /// Cloudinary publicId used as the mega-menu / collection hero art
  imageId     String?
  /// Whether `imageId` points at a still or a clip. Homepage banners have
  /// carried this since the start; shelves only ever took stills, so the
  /// default keeps every existing row behaving exactly as before.
  imageKind   MediaKind @default(IMAGE)
  position    Int     @default(0)
  isActive    Boolean @default(true)
  /// Render this top-level item highlighted in the nav (e.g. "Bridal")
  featured    Boolean @default(false)
  /// Which mega-menu column this sub-category sits in:
  /// OCCASION | CATEGORY | COLLECTION. Null for top-level rows.
  menuGroup   String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([position])
}

model Product {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  /// Short one-line hook shown on cards
  tagline       String?
  description   String
  /// Stored in paise (INR * 100) to keep money integral
  price         Int
  compareAtPrice Int?
  sku           String  @unique
  categoryId    String?
  fabric        String?
  color         String?
  craft         String?
  /// Accordion panels on the product page
  careNotes     String?
  deliveryInfo  String?
  disclaimer    String?
  /// Shown on the "Inquire about customization" panel
  customizable  Boolean @default(true)
  isActive      Boolean @default(true)
  isFeatured    Boolean @default(false)
  isNewArrival  Boolean @default(false)
  position      Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category  Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media     ProductMedia[]
  variants  ProductVariant[]
  cartItems CartItem[]
  orderItems OrderItem[]
  wishlist  WishlistItem[]

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isNewArrival])
}

/// Size/stock axis. Couture is usually made-to-measure, so "Bespoke"
/// is a legitimate variant with its own stock allowance.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  size      String
  stock     Int     @default(0)
  /// Added to the product price, in paise. May be negative.
  priceDelta Int    @default(0)
  position  Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size])
  @@index([productId])
}

/// A Cloudinary asset attached to a product. `publicId` is the Cloudinary
/// public id *including* its original extension so the delivery layer can
/// decide the right output format (.heic -> jpg, .mov -> mp4).
model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  publicId  String
  kind      MediaKind @default(IMAGE)
  alt       String?
  position  Int       @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([position])
}

/// Admin-editable homepage hero / banner slides.
model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  eyebrow   String?
  ctaLabel  String?
  ctaHref   String?
  publicId  String
  kind      MediaKind @default(IMAGE)
  /// Which homepage slot this belongs to: HERO, MARQUEE, EDITORIAL
  slot      String    @default("HERO")
  position  Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slot, position])
}

/// "In their own words" — the testimonial rail on the homepage.
model Testimonial {
  id        String    @id @default(cuid())
  author    String
  occasion  String?
  quote     String
  publicId  String
  kind      MediaKind @default(IMAGE)
  position  Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([position])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  /// Anonymous cart key stored in an httpOnly cookie
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int    @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id            String      @id @default(cuid())
  /// Human-facing reference, e.g. SK-2026-0001
  orderNumber   String      @unique
  userId        String?
  addressId     String?
  status        OrderStatus @default(PENDING)
  /// All amounts in paise
  subtotal      Int
  shipping      Int         @default(0)
  total         Int
  currency      String      @default("INR")
  email         String
  phone         String?
  notes         String?
  /// Address is snapshotted at purchase time so later edits don't rewrite history
  shipAddress   Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  /// Snapshot of what was bought, so the line survives product edits
  name      String
  size      String?
  imageId   String?
  unitPrice Int
  quantity  Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String        @default("razorpay")
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus @default(CREATED)
  amount            Int
  currency          String        @default("INR")
  method            String?
  errorCode         String?
  errorDescription  String?
  /// Raw provider payload for audit / reconciliation
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Status of a consultation request as the atelier works through it.
enum AppointmentStatus {
  NEW
  CONTACTED
  SCHEDULED
  CLOSED
}

/// A "Book a fitting" / "Request an appointment" enquiry.
///
/// Persisted before any notification is attempted, deliberately: email is the
/// part most likely to fail (missing key, provider outage, bounced domain),
/// and a consultation request that reaches nobody is a lost customer. The row
/// is the record of truth; the email is only the nudge.
model Appointment {
  id        String            @id @default(cuid())
  name      String
  email     String
  phone     String
  occasion  String?
  date      String?
  message   String?
  /// Name of the piece the visitor was looking at, when they came from a card.
  piece     String?
  status    AppointmentStatus @default(NEW)
  /// Whether the atelier notification actually went out.
  notified  Boolean           @default(false)
  /// Why the notification failed, when it did -- surfaced in the admin list.
  notifyError String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, createdAt])
}

enum CommissionStatus {
  NEW
  REVIEWING
  QUOTED
  IN_PROGRESS
  DELIVERED
  CLOSED
}

/// A bespoke jewellery commission: someone has sent us a reference of the
/// piece they want made.
///
/// Same discipline as `Appointment` -- the row is written before any email is
/// attempted, because a commission enquiry that reaches nobody is the most
/// expensive thing this site can lose. The uploaded reference lives in
/// Cloudinary and only its public id is stored here.
model Commission {
  id        String @id @default(cuid())
  /// Human-quotable, e.g. "SK-C-0007". Given to the customer on submit.
  reference String @unique

  name  String
  email String
  phone String

  /// What they want made, in their own words.
  brief String?

  /// Triage fields. All optional -- a half-filled form is still a lead, so
  /// nothing here is allowed to block a submission.
  metal    String?
  stones   String?
  budget   String?
  wearDate String?

  /// The reference image or clip the visitor uploaded, if they attached one.
  publicId  String?
  mediaKind MediaKind @default(IMAGE)

  /// The design fee quoted at the moment of submission, in paise. Stored per
  /// row rather than read from a constant so that raising the fee later does
  /// not silently rewrite what past customers were told.
  feePaise Int     @default(99900)
  feePaid  Boolean @default(false)

  status CommissionStatus @default(NEW)

  /// Whether the atelier notification actually went out, and why not.
  notified    Boolean @default(false)
  notifyError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}
